# ── Gemini (콘텐츠 생성 엔진)
GEMINI_API_KEY=

# ── Supabase (Auth + Postgres DB)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service key는 FastAPI webhook의 권한 쓰기에만 사용 (Streamlit 앱에는 넣지 말 것)
SUPABASE_SERVICE_KEY=

# ── Stripe (결제)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ── 앱 URL (Stripe Checkout 리다이렉트용)
APP_BASE_URL=http://localhost:8501
